<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="4" author="kirill.tulyakov">
        <createSequence schemaName="fact" sequenceName="actuals_seq" startValue="1" incrementBy="1"/>
        <createTable schemaName="fact" tableName="actuals">
            <column name="id" type="BIGINT" defaultValueComputed="nextval('fact.actuals_seq')">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_actuals"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="material_no" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ch3_ship_to_code" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="volume_units" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="actual_sales_value" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="fact"
                baseTableName="actuals"
                baseColumnNames="material_no"
                referencedTableSchemaName="ref"
                referencedTableName="products"
                referencedColumnNames="material_no"
                constraintName="fk_actuals_material"/>

        <addForeignKeyConstraint
                baseTableSchemaName="fact"
                baseTableName="actuals"
                baseColumnNames="ch3_ship_to_code"
                referencedTableSchemaName="ref"
                referencedTableName="customers"
                referencedColumnNames="ch3_ship_to_code"
                constraintName="fk_actuals_customer"/>
        
        <createIndex schemaName="fact" tableName="actuals" indexName="idx_actuals_material_ship_date">
            <column name="material_no"/>
            <column name="ch3_ship_to_code"/>
            <column name="date"/>
        </createIndex>

        <loadData
                file="db/data/actuals.csv"
                schemaName="fact"
                tableName="actuals"
                runOnChange="false"/>
    </changeSet>
</databaseChangeLog>