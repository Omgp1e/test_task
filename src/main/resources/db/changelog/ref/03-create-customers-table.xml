<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="3" author="kirill.tulyakov">
        <createTable schemaName="ref" tableName="customers">
            <column name="ch3_ship_to_code" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_customers_code"/>
            </column>
            <column name="ch3_ship_to_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="chain_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <loadData
                file="db/data/customers.csv"
                schemaName="ref"
                tableName="customers"
                runOnChange="false"/>
    </changeSet>
</databaseChangeLog>