<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="2" author="kirill.tulyakov">
        <createTable schemaName="ref" tableName="products">
            <column name="material_no" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_products_material"/>
            </column>
            <column name="material_desc_rus" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="l3_product_category_code" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="l3_product_category_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <loadData
                file="db/data/products.csv"
                schemaName="ref"
                tableName="products"
                runOnChange="false"/>
    </changeSet>
</databaseChangeLog>
